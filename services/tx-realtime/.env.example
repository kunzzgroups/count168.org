TX_REALTIME_HOST=127.0.0.1
TX_REALTIME_PORT=3912
# Must match $tx_realtime_secret in includes/config.local.php
# Org = 3912 + tx-realtime-org; site = 3911 + tx-realtime — do not mix.
TX_REALTIME_SECRET=change-me-to-a-long-random-string
# Optional — multi-instance fanout. Single EC2 can leave empty.
# REDIS_URL=redis://127.0.0.1:6379
