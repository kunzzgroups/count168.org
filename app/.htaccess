# Deploy Vite output (contents of frontend/frontend/dist/) into this directory as /app/ on the host.
# Keeps legacy PHP at site root (index.php, dashboard.php, /api/, etc.).

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /app/
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . index.html [L]
</IfModule>
