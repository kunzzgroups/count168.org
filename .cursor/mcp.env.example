# Cursor MCP 密钥模板（复制到 .cursor/mcp.json 对应字段，勿提交真实值）

# MySQL（与 includes/config.php 或 config.local.php 一致）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=13306
MYSQL_USER=admin
MYSQL_PASS=你的数据库密码
MYSQL_PASSWORD=你的数据库密码
MYSQL_DB=c168_org

# GitHub Personal Access Token（classic，建议勾选 repo）
# 生成：https://github.com/settings/tokens
GITHUB_PAT=ghp_你的token
