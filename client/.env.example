# 与 PHP 同域部署时留空，接口使用相对路径 /api/...
VITE_API_BASE=

# 生产：React 在子目录时填写，与线上一致、末尾加 /（例 /app/）。或 npm run build:app
# VITE_BASE_PATH=/app/

# 仅本地 npm run dev：与 PHP 同会话；登录后整页、以及 dashboard iframe 的 dashboard_classic.php 都需能访问该源
# VITE_DEV_POST_LOGIN_BASE=http://127.0.0.1

# 仅 Vite 开发服代理用（不暴露到浏览器，写在 client/.env.development）：
# DEV_PHP_ORIGIN=http://127.0.0.1
