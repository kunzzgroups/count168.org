# count168.org — React SPA + api/v1
# 已去掉「对 *.php 的强制外跳」：让网站根下各 .php 自己执行，避免拦截 index.php 与带 ?lang= 的跳转
# 默认前端为 Hash 路由，只需能访问到 /app/index.html
RewriteEngine On
RewriteBase /

<IfModule mod_negotiation.c>
  Options -MultiViews
</IfModule>

# 空域名 → 直接打开 SPA
RewriteRule ^$ /app/index.html [L]

# 真实文件/目录
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# API 不交给 index.html
RewriteCond %{REQUEST_URI} ^/api/v1/ [NC]
RewriteRule ^ - [L]

# 其它（如 /app/login 的 History 模式书签）：回退到 SPA；Hash 模式主要用 /app/index.html#/…
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ /app/index.html [L]

DirectoryIndex app/index.html index.html
