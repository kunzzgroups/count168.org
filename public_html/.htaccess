RewriteEngine On

# 根路径没有默认首页时，部分虚拟主机直接返回 403；显式进入 SPA
RewriteRule ^$ /app/index.html [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteCond %{REQUEST_URI} ^/api/v1/ [NC]
RewriteRule ^ - [L]

RewriteRule ^ /app/index.html [L]

DirectoryIndex app/index.html index.html
